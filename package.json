{
  "name": "mobile-games",
  "version": "0.0.0",
  "private": true,
  "description": "Jeu web de survie zombies en vue de dessus (GitHub Pages).",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:full": "E2E_FULL=1 playwright test",
    "test:avant-commit": "node scripts/tests/palier.mjs avant-commit",
    "test:standard": "node scripts/tests/palier.mjs standard",
    "test:publication": "node scripts/tests/palier.mjs publication",
    "test:complet": "node scripts/tests/palier.mjs complet",
    "test:selection": "node scripts/tests/palier.mjs selection",
    "test:fumee": "node scripts/tests/palier.mjs fumee",
    "test:budget": "node scripts/tests/budget.mjs --palier complet --non-bloquant",
    "build": "node scripts/build.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "assemble": "node scripts/assemble.mjs",
    "site": "node scripts/site/local.mjs",
    "archive": "node scripts/versions/archiver.mjs",
    "serve:site": "node scripts/site/serve.mjs --root _site --base /Z-Survival/",
    "vendor:three": "node scripts/vendor-three.mjs",
    "carte": "node scripts/plan-vers-monde.mjs",
    "publication:controle": "node scripts/publication/controler.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "three": "0.186.1",
    "vitest": "5.0.5"
  }
}
